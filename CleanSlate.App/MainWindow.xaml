<Window x:Class="CleanSlate.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:CleanSlate.UI"
        Title="CleanSlate — удаление программ и их данных"
        Width="1200" Height="780" MinWidth="1000" MinHeight="640"
        Background="{StaticResource Bg}" FontFamily="Segoe UI" FontSize="13"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Боковая панель -->
        <Border Background="#1F2430">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="20,24,20,22">
                    <TextBlock Text="CleanSlate" Foreground="White" FontSize="22" FontWeight="Bold"/>
                    <TextBlock Text="Удаление программ и остатков" Foreground="#8A92A6" FontSize="11" Margin="0,2,0,0"/>
                </StackPanel>
                <TextBlock DockPanel.Dock="Bottom" Text="Работает локально, без интернета" Foreground="#8A92A6" FontSize="11" Margin="20,0,20,16" TextWrapping="Wrap"/>
                <StackPanel>
                    <RadioButton x:Name="NavPrograms" Style="{StaticResource Nav}" Content="Программы" Tag="Programs" IsChecked="True" Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavManual"   Style="{StaticResource Nav}" Content="Остатки"   Tag="Manual"   Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavLog"      Style="{StaticResource Nav}" Content="Журнал"    Tag="Log"      Checked="Nav_Checked"/>
                    <RadioButton x:Name="NavSettings" Style="{StaticResource Nav}" Content="Настройки" Tag="Settings" Checked="Nav_Checked"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" Margin="20">

            <!-- ПРОГРАММЫ -->
            <Grid x:Name="PagePrograms">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="340"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Card}" Padding="12">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Установленные программы" FontSize="15" FontWeight="SemiBold" Margin="4,0,0,8"/>
                        <TextBox x:Name="SearchBox" DockPanel.Dock="Top" TextChanged="SearchBox_TextChanged" ToolTip="Поиск по названию"/>
                        <TextBlock x:Name="CountText" DockPanel.Dock="Top" Foreground="{StaticResource Muted}" Margin="4,6,0,8"/>
                        <ListBox x:Name="ProgramList" BorderThickness="0" HorizontalContentAlignment="Stretch"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 SelectionChanged="ProgramList_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="4,4">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Subtitle}" Foreground="{StaticResource Muted}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>

                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock x:Name="DetailName" Text="Выберите программу слева" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                <TextBlock Text="Издатель" Foreground="{StaticResource Muted}"/>
                                <TextBlock x:Name="DetailPublisher" Grid.Column="1" TextWrapping="Wrap"/>
                                <TextBlock Grid.Row="1" Text="Версия" Foreground="{StaticResource Muted}"/>
                                <TextBlock x:Name="DetailVersion" Grid.Row="1" Grid.Column="1"/>
                                <TextBlock Grid.Row="2" Text="Путь установки" Foreground="{StaticResource Muted}"/>
                                <TextBlock x:Name="DetailPath" Grid.Row="2" Grid.Column="1" TextWrapping="Wrap" FontFamily="Consolas"/>
                                <TextBlock Grid.Row="3" Text="Деинсталлятор" Foreground="{StaticResource Muted}"/>
                                <TextBlock x:Name="DetailUninstall" Grid.Row="3" Grid.Column="1" TextWrapping="Wrap"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="2" Style="{StaticResource Card}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="Найденные дополнительные данные" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10"/>
                            <ui:LeftoverListControl x:Name="ProgramLeftovers"/>
                        </DockPanel>
                    </Border>

                    <StackPanel Grid.Row="4" Orientation="Horizontal">
                        <Button x:Name="BtnUninstall" Style="{StaticResource DangerButton}" Content="Удалить программу" Click="Uninstall_Click" IsEnabled="False"/>
                        <Button x:Name="BtnCleanProgram" Content="Очистить остатки" Click="CleanProgram_Click" IsEnabled="False"/>
                        <Button Style="{StaticResource Secondary}" Content="Обновить список" Click="Refresh_Click"/>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- ОСТАТКИ -->
            <Grid x:Name="PageManual" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Остатки уже удалённой программы" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,12"
                                   Text="Введите название (и по возможности издателя) — так поиск будет точнее. Без издателя папки считаются непроверенными и не отмечаются автоматически."/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="Название" Foreground="{StaticResource Muted}" Margin="0,0,0,3"/><TextBox x:Name="ManualName"/></StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock Text="Издатель (необязательно)" Foreground="{StaticResource Muted}" Margin="0,0,0,3"/><TextBox x:Name="ManualPublisher"/></StackPanel>
                            <StackPanel Grid.Column="4"><TextBlock Text="Прежний путь установки (необязательно)" Foreground="{StaticResource Muted}" Margin="0,0,0,3"/><TextBox x:Name="ManualPath"/></StackPanel>
                            <Button Grid.Column="6" VerticalAlignment="Bottom" Margin="0" Content="Найти остатки" Click="ManualScan_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource Card}">
                    <ui:LeftoverListControl x:Name="ManualLeftovers"/>
                </Border>

                <StackPanel Grid.Row="4" Orientation="Horizontal">
                    <Button Style="{StaticResource DangerButton}" Content="Очистить остатки" Click="ManualClean_Click"/>
                </StackPanel>
            </Grid>

            <!-- ЖУРНАЛ -->
            <Grid x:Name="PageLog" Visibility="Collapsed">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <TextBlock Text="Журнал операций" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,24,0"/>
                    <Button Style="{StaticResource Secondary}" Content="Открыть папку журналов" Click="OpenLogs_Click"/>
                    <Button Style="{StaticResource Secondary}" Content="Очистить экран" Click="ClearLogView_Click"/>
                </StackPanel>
                <Border Grid.Row="1" Style="{StaticResource Card}" Padding="4">
                    <ListView x:Name="LogList" BorderThickness="0">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Время" Width="80" DisplayMemberBinding="{Binding TimeText}"/>
                                <GridViewColumn Header="Уровень" Width="80" DisplayMemberBinding="{Binding Level}"/>
                                <GridViewColumn Header="Сообщение" Width="820" DisplayMemberBinding="{Binding Message}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Border>
            </Grid>

            <!-- НАСТРОЙКИ -->
            <Grid x:Name="PageSettings" Visibility="Collapsed">
                <Border Style="{StaticResource Card}" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="Настройки" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>
                        <CheckBox x:Name="SetProgramData" Content="Искать также в %PROGRAMDATA%" Margin="0,0,0,8" Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                        <CheckBox x:Name="SetInstallDir" Content="Показывать каталог установки среди найденных данных" Margin="0,0,0,8" Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                        <CheckBox x:Name="SetQuiet" Content="Использовать «тихое» удаление, если программа его поддерживает (иначе — обычное окно деинсталлятора)" Margin="0,0,0,16" Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                        <TextBlock Text="Всегда проверяются: %LOCALAPPDATA%, %APPDATA%, AppData\LocalLow, Saved Games, Документы." Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
                        <TextBlock x:Name="LogPathText" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                        <TextBlock Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0"
                                   Text="Приложение не запрашивает права администратора. Если для удаления нужны повышенные права, операция завершится понятной ошибкой в журнале."/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
